generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PomodoroPhase {
  FOCUS
  BREAK
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  // Six-digit code emailed to the user; exchanged for a PASSWORD_RESET token.
  PASSWORD_RESET_CODE
  // Long random token that authorises setting a new password.
  PASSWORD_RESET
  TWO_FACTOR_ENABLE_CODE
  TWO_FACTOR_DISABLE_CODE
}

enum Role {
  USER
  // Owner-like powers in rooms they are a member of, plus a read-only user list.
  MODERATOR
  ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum TimerStatus {
  // Between phases: waiting for the owner to start `phase`.
  IDLE
  RUNNING
  PAUSED
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  username        String    @unique
  // Nullable for existing profiles and future external login providers.
  // Password login must reject accounts without a hash.
  passwordHash    String?
  // Set when the owner proves they control `email`; clear it whenever the
  // email changes. Null means unverified (all pre-existing accounts).
  emailVerifiedAt DateTime?
  // Site-wide permission level. Granted with `npm run users:role`; only an admin
  // can then change others through /api/admin.
  role            Role      @default(USER)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  avatar             UserAvatar?
  authSessions       AuthSession[]
  emailTokens        EmailToken[]
  twoFactorEnabledAt DateTime?
  oAuthAccounts      OAuthAccount[]
  oAuthCodes         OAuthCode[]
  loginChallenges    LoginChallenge[]
  friendRequests     Friendship[]     @relation("FriendshipRequester")
  friendInvites      Friendship[]     @relation("FriendshipAddressee")
  memberships        SessionMember[]
  stat               UserStat?
}

// Profile picture, stored in the database so it needs no file volume. The API
// only accepts PNG, JPEG or WebP up to 512 KB; without a row a default is served.
model UserAvatar {
  userId      Int      @id
  contentType String
  data        Bytes
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  // Store a hash of a random session token, never the bearer token itself.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// One-time links sent by email: address verification and password reset.
model EmailToken {
  id             String            @id @default(uuid()) @db.Uuid
  userId         Int
  purpose        EmailTokenPurpose
  // Address the link was sent to. A verification only counts while this still
  // equals User.email, so changing the address invalidates old links.
  email          String
  // Store a hash of a random token, never the token that was emailed.
  tokenHash      String            @unique
  expiresAt      DateTime
  // Set when consumed; a used token must never work twice.
  usedAt         DateTime?
  // Wrong guesses against a short code; stop accepting it after a few.
  failedAttempts Int               @default(0)
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Step between a correct password and a full session when 2FA is on. The
// client holds the raw token and must present a valid second factor with it.
model LoginChallenge {
  id             String   @id @default(uuid()) @db.Uuid
  userId         Int
  tokenHash      String   @unique
  // Short-lived (minutes), unlike a session.
  expiresAt      DateTime
  // Wrong second-factor attempts; delete the challenge after a few.
  failedAttempts Int      @default(0)
  codeHash       String
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GuestSession {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  memberships SessionMember[]

  @@index([expiresAt])
}

// A study session is the server people join: its settings, its join code, its
// chat and its one shared timer. The owner is the member with isOwner = true.
model PomodoroSession {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  // The shared code that lets anyone who has it join; the owner can replace it.
  // Null for a solo timer: nobody can join it.
  code           String?         @unique
  focusSeconds   Int             @default(1500)
  breakSeconds   Int             @default(300)
  // The timer. `phase` is the running phase, or the next one while IDLE.
  phase          PomodoroPhase   @default(FOCUS)
  timerStatus    TimerStatus     @default(IDLE)
  // Set exactly while RUNNING: the moment it last (re)started.
  resumedAt      DateTime?
  // Active time before resumedAt, excluding pauses.
  elapsedSeconds Int             @default(0)
  createdAt      DateTime        @default(now())
  members        SessionMember[]

  @@index([timerStatus])
}

// Someone (a user or a guest) who is in a session. Members are in the timer: a
// member who leaves or is kicked is deleted, and rejoining needs the code.
model SessionMember {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  // Exactly one identity; enforced by a SQL CHECK in the migration.
  userId         Int?
  guestSessionId String?         @db.Uuid
  joinedAt       DateTime        @default(now())
  // While in the future the member can read the chat but not post.
  mutedUntil     DateTime?
  // Exactly one per session; a partial unique index in the migration.
  isOwner        Boolean         @default(false)
  // Focus time is counted from here, then moved forward.
  creditedAt     DateTime        @default(now())
  session        PomodoroSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession?   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@unique([sessionId, guestSessionId])
  @@index([userId])
  @@index([guestSessionId])
}

// A friend request from requester to addressee; ACCEPTED makes it mutual. A
// declined, cancelled or removed friendship is simply deleted.
model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // A SQL unique index on the unordered pair also stops B->A once A->B exists.
  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Lifetime totals of a registered user: time studied and minigame wins/losses
// (played = wins + losses, all games together). Guests have none. Kept apart from
// SessionMember so leaving or deleting a session doesn't erase them.
model UserStat {
  userId         Int  @id
  focusedSeconds Int  @default(0)
  wins           Int  @default(0)
  losses         Int  @default(0)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum OAuthProvider {
  GOOGLE
  GITHUB
  FORTY_TWO
}

model OAuthAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         Int
  provider       OAuthProvider
  providerUserId String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
}

model OAuthCode {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  codeHash  String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PendingSignup {
  id             String         @id @default(uuid()) @db.Uuid
  tokenHash      String         @unique
  email          String         @unique
  username       String
  passwordHash   String?
  provider       OAuthProvider?
  providerUserId String?
  codeHash       String
  failedAttempts Int            @default(0)
  resends        Int            @default(0)
  resendWindowAt DateTime
  createdAt      DateTime       @default(now())
  expiresAt      DateTime

  @@index([expiresAt])
}
