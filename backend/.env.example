# Keep your existing hosted database connection string in .env.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Number of reverse proxies in front of the API (0 when exposed directly).
# Used for client IPs in rate limiting; too high lets clients spoof their IP.
TRUST_PROXY=0
# Encrypts two-factor secrets at rest: 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of version control and back it up: if it changes or is lost,
# every stored 2FA secret becomes unreadable and those users are locked out.
TWO_FACTOR_KEY=
# Email for password reset codes. Gmail: turn on 2-Step Verification, then create
# an App Password at https://myaccount.google.com/apppasswords and paste it here
# (your normal Gmail password will not work). Leave SMTP_USER empty in development
# to just log emails to the console.
SMTP_USER=
SMTP_PASSWORD=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (default 465)
# and MAIL_FROM (default "WePomodoro <SMTP_USER>").

# Development only: set to "true" so the /dev console can act as any user without
# a token (X-Dev-User header). Ignored when NODE_ENV=production; never set on a shared server.
DEV_AUTH=false
