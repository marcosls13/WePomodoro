generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PomodoroPhase {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum EmailTokenPurpose {
  EMAIL_VERIFICATION
  // Six-digit code emailed to the user; exchanged for a PASSWORD_RESET token.
  PASSWORD_RESET_CODE
  // Long random token that authorises setting a new password.
  PASSWORD_RESET
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  username        String    @unique
  // Nullable for existing profiles and future external login providers.
  // Password login must reject accounts without a hash.
  passwordHash    String?
  // Set when the owner proves they control `email`; clear it whenever the
  // email changes. Null means unverified (all pre-existing accounts).
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  authSessions    AuthSession[]
  emailTokens     EmailToken[]
  twoFactor       TwoFactor?
  recoveryCodes   RecoveryCode[]
  loginChallenges LoginChallenge[]
  ownedRooms      StudyRoom[]
  invites         Invite[]
  friendRequests  Friendship[]         @relation("FriendshipRequester")
  friendInvites   Friendship[]         @relation("FriendshipAddressee")
  messages        Message[]
  presence        Presence?
  joinAsks        JoinRequest[]        @relation("JoinRequester")
  joinOffers      JoinRequest[]        @relation("JoinTarget")
  memberships     RoomMember[]
  studyHistory    SessionParticipant[]
  gameResults     GameResult[]
}

model AuthSession {
  id        String   @id @default(uuid()) @db.Uuid
  userId    Int
  // Store a hash of a random session token, never the bearer token itself.
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// One-time links sent by email: address verification and password reset.
model EmailToken {
  id             String            @id @default(uuid()) @db.Uuid
  userId         Int
  purpose        EmailTokenPurpose
  // Address the link was sent to. A verification only counts while this still
  // equals User.email, so changing the address invalidates old links.
  email          String
  // Store a hash of a random token, never the token that was emailed.
  tokenHash      String            @unique
  expiresAt      DateTime
  // Set when consumed; a used token must never work twice.
  usedAt         DateTime?
  // Wrong guesses against a short code; stop accepting it after a few.
  failedAttempts Int               @default(0)
  createdAt      DateTime          @default(now())
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Time-based one-time password (TOTP) enrolment; at most one per user.
model TwoFactor {
  userId           Int       @id
  // The secret must be readable to verify codes, so encrypt it with a server
  // key in the application. Never return it after enrolment.
  secretCiphertext String
  // Null while enrolling (secret shown, first code not yet confirmed). Login
  // only asks for a code once this is set.
  enabledAt        DateTime?
  // 30-second time step of the last accepted code. Accept only later steps so
  // an intercepted code can't be replayed.
  lastUsedStep     Int?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Single-use backup codes for when the authenticator is lost.
model RecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    Int
  // Hash of the code; show the plain codes to the user once, at generation.
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

// Step between a correct password and a full session when 2FA is on. The
// client holds the raw token and must present a valid second factor with it.
model LoginChallenge {
  id             String   @id @default(uuid()) @db.Uuid
  userId         Int
  tokenHash      String   @unique
  // Short-lived (minutes), unlike a session.
  expiresAt      DateTime
  // Wrong second-factor attempts; delete the challenge after a few.
  failedAttempts Int      @default(0)
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GuestSession {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String
  tokenHash   String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  memberships  RoomMember[]
  studyHistory SessionParticipant[]
  messages     Message[]

  @@index([expiresAt])
}

model StudyRoom {
  id                    String            @id @default(uuid()) @db.Uuid
  name                  String
  ownerId               Int
  focusSeconds          Int               @default(1500)
  shortBreakSeconds     Int               @default(300)
  longBreakSeconds      Int               @default(900)
  cyclesBeforeLongBreak Int               @default(4)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  // Close rooms instead of deleting them to preserve study history.
  closedAt              DateTime?
  owner                 User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members               RoomMember[]
  invites               Invite[]
  messages              Message[]
  presence              Presence[]
  joinRequests          JoinRequest[]
  sessions              PomodoroSession[]

  @@index([ownerId])
}

// One personal join code per registered member per room. Codes are random and
// grow longer when the short ones start colliding, so there is no fixed length.
model Invite {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @db.Uuid
  createdById Int
  code        String    @unique
  createdAt   DateTime  @default(now())
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([roomId, createdById])
  @@index([createdById])
}

model RoomMember {
  id             String        @id @default(uuid()) @db.Uuid
  roomId         String        @db.Uuid
  // Exactly one identity; enforced by a SQL CHECK in the migration.
  userId         Int?
  guestSessionId String?       @db.Uuid
  joinedAt       DateTime      @default(now())
  room           StudyRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  // Membership lasts until the person leaves the server or is kicked (the row is
  // deleted, so rejoining needs a code). Closing the app or disconnecting never
  // touches it; presence in a timer is SessionParticipant.leftAt.
  @@unique([roomId, userId])
  @@unique([roomId, guestSessionId])
  @@index([userId])
  @@index([guestSessionId])
}

// A friend request from requester to addressee; ACCEPTED makes it mutual. A
// declined, cancelled or removed friendship is simply deleted.
model Friendship {
  id          String           @id @default(uuid()) @db.Uuid
  requesterId Int
  addresseeId Int
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  // A SQL unique index on the unordered pair also stops B->A once A->B exists.
  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
}

// Chat for a server. Messages outlive their author, so the name is a snapshot
// and the author link is cleared (not deleted) when the account or guest goes.
model Message {
  id             Int           @id @default(autoincrement())
  roomId         String        @db.Uuid
  userId         Int?
  guestSessionId String?       @db.Uuid
  authorName     String
  content        String
  createdAt      DateTime      @default(now())
  room           StudyRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestSession   GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)

  @@index([roomId, id])
}

// Where a registered user is right now. The client sends a heartbeat; a row
// whose seenAt is older than the freshness window means offline.
model Presence {
  userId Int        @id
  roomId String?    @db.Uuid
  seenAt DateTime
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  room   StudyRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@index([seenAt])
}

// "Let me into the server you are in." Accepting adds the requester as a
// member and deletes the row; declining or cancelling just deletes it.
model JoinRequest {
  id          String    @id @default(uuid()) @db.Uuid
  roomId      String    @db.Uuid
  requesterId Int
  targetId    Int
  createdAt   DateTime  @default(now())
  room        StudyRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  requester   User      @relation("JoinRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target      User      @relation("JoinTarget", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([roomId, requesterId, targetId])
  @@index([targetId])
  @@index([requesterId])
}

model PomodoroSession {
  id             String               @id @default(uuid()) @db.Uuid
  // Null means a solo timer; a room session shares a timer across participants.
  roomId         String?              @db.Uuid
  phase          PomodoroPhase        @default(FOCUS)
  status         SessionStatus        @default(ACTIVE)
  // Snapshot the duration so changing room settings doesn't rewrite history.
  plannedSeconds Int                  @default(1500)
  startedAt      DateTime             @default(now())
  endedAt        DateTime?
  resumedAt      DateTime?
  pausedAt       DateTime?
  // Accumulated active time at the last pause; exclude paused time.
  elapsedSeconds Int                  @default(0)
  room           StudyRoom?           @relation(fields: [roomId], references: [id], onDelete: SetNull)
  participants   SessionParticipant[]

  @@index([roomId, startedAt])
  @@index([status, startedAt])
}

model SessionParticipant {
  id             String          @id @default(uuid()) @db.Uuid
  sessionId      String          @db.Uuid
  // Exactly one identity; enforced by a SQL CHECK in the migration.
  userId         Int?
  guestSessionId String?         @db.Uuid
  joinedAt       DateTime        @default(now())
  leftAt         DateTime?
  creditedAt     DateTime        @default(now())
  // Actual focused time for this person, excluding pauses and late arrival.
  focusedSeconds Int             @default(0)
  // Set when this person completes a focus interval, not merely on room completion.
  completedAt    DateTime?
  session        PomodoroSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSession   GuestSession?   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@unique([sessionId, guestSessionId])
  @@index([userId, joinedAt])
  @@index([guestSessionId])
}

model MiniGame {
  id        Int          @id @default(autoincrement())
  key       String       @unique
  name      String
  isEnabled Boolean      @default(true)
  results   GameResult[]
}

model GameResult {
  id              String   @id @default(uuid()) @db.Uuid
  userId          Int
  gameId          Int
  score           Int
  durationSeconds Int
  playedAt        DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game            MiniGame @relation(fields: [gameId], references: [id], onDelete: Restrict)

  @@index([userId, playedAt])
  @@index([userId, gameId, score])
  @@index([gameId])
}
